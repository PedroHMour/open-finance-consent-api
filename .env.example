NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Usado ao rodar a API fora do Docker (npm run dev). O compose expõe o banco na porta 5433.
DATABASE_URL=postgresql://openfinance:openfinance@localhost:5433/openfinance
DB_HOST_PORT=5433

# Gere valores fortes, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
JWT_ISSUER=open-finance-consent-api
ACCESS_TOKEN_TTL_SECONDS=900

# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Validade máxima de um consentimento, em dias
CONSENT_MAX_DAYS=365

# Número de proxies confiáveis na frente da API (0 = acesso direto)
TRUST_PROXY=0
