generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  cpf          String   @unique
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  accounts     Account[]
  consents     Consent[]  @relation("ConsentOwner")
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Account {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  accountNumber String      @unique @map("account_number")
  agency        String
  type          AccountType
  balance       Decimal     @default(0) @db.Decimal(15, 2)
  currency      String      @default("BRL")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  consents     ConsentAccount[]

  @@map("accounts")
}

model Transaction {
  id              String            @id @default(uuid())
  accountId       String            @map("account_id")
  type            TransactionType
  amount          Decimal           @db.Decimal(15, 2)
  description     String
  counterpartyName String?          @map("counterparty_name")
  counterpartyDoc  String?          @map("counterparty_doc")
  status          TransactionStatus @default(COMPLETED)
  transactedAt    DateTime          @default(now()) @map("transacted_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Consent {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  clientId     String        @map("client_id")
  clientName   String        @map("client_name")
  status       ConsentStatus @default(AWAITING_AUTHORISATION)
  permissions  String[]
  expiresAt    DateTime      @map("expires_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  revokedAt    DateTime?     @map("revoked_at")
  revokedBy    String?       @map("revoked_by")

  user     User             @relation("ConsentOwner", fields: [userId], references: [id], onDelete: Cascade)
  accounts ConsentAccount[]
  auditLogs AuditLog[]

  @@map("consents")
}

model ConsentAccount {
  id        String @id @default(uuid())
  consentId String @map("consent_id")
  accountId String @map("account_id")

  consent Consent @relation(fields: [consentId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([consentId, accountId])
  @@map("consent_accounts")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  consentId String?  @map("consent_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  consent Consent? @relation(fields: [consentId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  CHECKING
  SAVINGS
  SALARY
}

enum TransactionType {
  DEBIT
  CREDIT
  PIX
  TED
  DOC
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ConsentStatus {
  AWAITING_AUTHORISATION
  AUTHORISED
  REJECTED
  REVOKED
  EXPIRED
}
